generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  en
  fa
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum MaintenanceCategory {
  ENGINE
  FILTERS
  FLUIDS
  BRAKES
  TIRES
  ELECTRICAL
  SUSPENSION
  TRANSMISSION
  COOLING
  EXTERIOR
  INSPECTION
  OTHER
}

enum ExpenseCategory {
  MAINTENANCE
  REPAIR
  PARTS
  TIRES
  FUEL
  INSURANCE
  OTHER
}

enum ReminderType {
  DATE
  ODOMETER
  COMBINED
}

enum ReminderStatus {
  PENDING
  TRIGGERED
  DISMISSED
  COMPLETED
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String    @map("password_hash")
  avatarUrl         String?   @map("avatar_url")
  preferredLanguage Language  @default(en) @map("preferred_language")
  timezone          String    @default("UTC")
  theme             Theme     @default(SYSTEM)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  vehicles          Vehicle[]

  @@map("users")
}

model Vehicle {
  id                String              @id @default(cuid())
  userId            String              @map("user_id")
  name              String
  make              String
  model             String
  year              Int?
  trim              String?
  fuelType          String?             @map("fuel_type")
  transmission      String?
  plateNumber       String?             @map("plate_number")
  vin               String?
  currentOdometer   Int                 @default(0) @map("current_odometer")
  imageUrl          String?             @map("image_url")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenanceItems  MaintenanceItem[]
  maintenanceRecords MaintenanceRecord[]
  odometerRecords   OdometerRecord[]
  expenses          Expense[]
  reminders         Reminder[]

  @@index([userId])
  @@map("vehicles")
}

model MaintenanceItem {
  id                    String               @id @default(cuid())
  vehicleId             String               @map("vehicle_id")
  name                  String
  category              MaintenanceCategory  @default(OTHER)
  description           String?
  intervalKm            Int?                 @map("interval_km")
  intervalDays          Int?                 @map("interval_days")
  lastServiceDate       DateTime?             @db.Date @map("last_service_date")
  lastServiceOdometer   Int?                  @map("last_service_odometer")
  nextServiceDate       DateTime?             @db.Date @map("next_service_date")
  nextServiceOdometer   Int?                  @map("next_service_odometer")
  enabled               Boolean              @default(true)
  notes                 String?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  vehicle               Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  records               MaintenanceRecord[]
  reminders             Reminder[]

  @@index([vehicleId, enabled])
  @@map("maintenance_items")
}

model MaintenanceRecord {
  id                String           @id @default(cuid())
  vehicleId         String           @map("vehicle_id")
  maintenanceItemId String?          @map("maintenance_item_id")
  serviceDate       DateTime         @db.Date @map("service_date")
  odometer          Int
  cost              Decimal?         @db.Decimal(14, 0)
  provider          String?
  notes             String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceItem   MaintenanceItem? @relation(fields: [maintenanceItemId], references: [id], onDelete: SetNull)
  expense           Expense?

  @@index([vehicleId, serviceDate])
  @@index([maintenanceItemId])
  @@map("maintenance_records")
}

model OdometerRecord {
  id         String   @id @default(cuid())
  vehicleId  String   @map("vehicle_id")
  odometer   Int
  recordedAt DateTime @db.Date @map("recorded_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@index([odometer])
  @@map("odometer_records")
}

model Expense {
  id                  String                @id @default(cuid())
  vehicleId           String                @map("vehicle_id")
  category            ExpenseCategory       @default(MAINTENANCE)
  amount              Decimal               @db.Decimal(14, 0)
  currency            String                @default("TOMAN")
  date                DateTime              @db.Date
  description         String?
  maintenanceRecordId String?               @unique @map("maintenance_record_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  vehicle             Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceRecord   MaintenanceRecord?    @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([vehicleId, date])
  @@map("expenses")
}

model Reminder {
  id                String          @id @default(cuid())
  vehicleId         String          @map("vehicle_id")
  maintenanceItemId String          @map("maintenance_item_id")
  reminderType      ReminderType    @map("reminder_type")
  triggerDate       DateTime?       @db.Date @map("trigger_date")
  triggerOdometer   Int?            @map("trigger_odometer")
  status            ReminderStatus  @default(PENDING)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceItem   MaintenanceItem @relation(fields: [maintenanceItemId], references: [id], onDelete: Cascade)

  @@unique([maintenanceItemId])
  @@index([vehicleId, status])
  @@map("reminders")
}
